{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bist:schema:experiment:2",
  "title": "BIST experiment bundle version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "provenance",
    "configuration",
    "results",
    "diagnostics"
  ],
  "properties": {
    "schema": { "const": "bist-experiment" },
    "schemaVersion": { "const": 2 },
    "provenance": { "$ref": "#/$defs/provenance" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "results": { "$ref": "#/$defs/results" },
    "diagnostics": { "type": "object" }
  },
  "$defs": {
    "finiteNumber": { "type": "number" },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "nullableNumber": { "type": ["number", "null"] },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xMin", "xMax", "yMin", "yMax"],
      "properties": {
        "xMin": { "$ref": "#/$defs/finiteNumber" },
        "xMax": { "$ref": "#/$defs/finiteNumber" },
        "yMin": { "$ref": "#/$defs/finiteNumber" },
        "yMax": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software", "source", "exportedAt"],
      "properties": {
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "workingTree"],
          "properties": {
            "commit": { "type": "string", "minLength": 1 },
            "workingTree": { "enum": ["clean", "dirty", "unknown"] }
          }
        },
        "exportedAt": { "type": "string", "format": "date-time" },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fromSchemaVersion"],
          "properties": {
            "fromSchemaVersion": { "const": 1 }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "parameters", "initialExtendedState", "view", "solvers"],
      "properties": {
        "system": { "$ref": "#/$defs/system" },
        "parameters": { "$ref": "#/$defs/parameters" },
        "initialExtendedState": { "$ref": "#/$defs/extendedState" },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "required": ["computationDomain", "viewport"],
          "properties": {
            "computationDomain": { "$ref": "#/$defs/domain" },
            "viewport": { "$ref": "#/$defs/domain" }
          }
        },
        "solvers": { "$ref": "#/$defs/solvers" }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "equations",
        "customParameters",
        "boundedNoiseExtension"
      ],
      "properties": {
        "id": { "enum": ["henon", "duffing", "custom", "duffing_ode", "custom_ode"] },
        "type": { "enum": ["discrete", "continuous"] },
        "equations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interpretation", "x", "y"],
          "properties": {
            "interpretation": { "enum": ["map", "vector_field"] },
            "x": { "type": "string", "minLength": 1 },
            "y": { "type": "string", "minLength": 1 }
          }
        },
        "customParameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "$ref": "#/$defs/finiteNumber" }
            }
          }
        },
        "boundedNoiseExtension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["radiusParameter", "noiseNorm", "method"],
          "properties": {
            "radiusParameter": { "const": "epsilon" },
            "noiseNorm": { "const": "euclidean" },
            "method": { "enum": ["boundary_map", "boundary_differential_equation"] }
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "b",
        "delta",
        "h",
        "epsilon",
        "startX",
        "startY",
        "maxIterations",
        "maxPeriod"
      ],
      "properties": {
        "a": { "$ref": "#/$defs/finiteNumber" },
        "b": { "$ref": "#/$defs/finiteNumber" },
        "delta": { "type": "number", "minimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "epsilon": { "type": "number", "minimum": 0 },
        "startX": { "$ref": "#/$defs/finiteNumber" },
        "startY": { "$ref": "#/$defs/finiteNumber" },
        "maxIterations": { "$ref": "#/$defs/positiveInteger" },
        "maxPeriod": { "type": "integer", "minimum": 1, "maximum": 20 }
      }
    },
    "extendedState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "nx", "ny"],
      "properties": {
        "x": { "$ref": "#/$defs/finiteNumber" },
        "y": { "$ref": "#/$defs/finiteNumber" },
        "nx": { "$ref": "#/$defs/finiteNumber" },
        "ny": { "$ref": "#/$defs/finiteNumber" }
      }
    },
    "solvers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trajectory",
        "periodicSearch",
        "manifold",
        "continuousBoundaryFlow",
        "ulam",
        "geometricOffsets"
      ],
      "properties": {
        "trajectory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumIterations"],
          "properties": {
            "maximumIterations": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        "periodicSearch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumPeriod",
            "gridSize",
            "thetaGridSize",
            "residualThreshold",
            "useContinuation",
            "supportFilter"
          ],
          "properties": {
            "maximumPeriod": { "type": "integer", "minimum": 1, "maximum": 20 },
            "gridSize": { "type": "integer", "minimum": 2, "maximum": 256 },
            "thetaGridSize": { "type": "integer", "minimum": 2, "maximum": 256 },
            "residualThreshold": { "type": "number", "minimum": 1e-14, "maximum": 0.01 },
            "useContinuation": { "type": "boolean" },
            "supportFilter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subdivisions", "pointsPerBox", "supportThreshold"],
              "properties": {
                "subdivisions": { "$ref": "#/$defs/positiveInteger" },
                "pointsPerBox": { "$ref": "#/$defs/positiveInteger" },
                "supportThreshold": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        },
        "manifold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intersectionThreshold", "computeStable", "computeUnstable"],
          "properties": {
            "intersectionThreshold": { "type": "number", "minimum": 0 },
            "maximumPointSpacing": { "type": "number", "minimum": 0.0001, "maximum": 0.05 },
            "computeStable": { "type": "boolean" },
            "computeUnstable": { "type": "boolean" }
          }
        },
        "continuousBoundaryFlow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "integrator",
            "stepSize",
            "initialRadius",
            "sampleCount",
            "stepsPerAnimationFrame",
            "reparameterizeEveryFrames"
          ],
          "properties": {
            "integrator": { "type": "string", "minLength": 1 },
            "stepSize": { "type": "number", "exclusiveMinimum": 0 },
            "initialRadius": { "type": "number", "exclusiveMinimum": 0 },
            "sampleCount": { "type": "integer", "minimum": 3 },
            "stepsPerAnimationFrame": { "$ref": "#/$defs/positiveInteger" },
            "reparameterizeEveryFrames": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        "ulam": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subdivisions",
            "pointsPerBox",
            "epsilon",
            "integrationTime",
            "stationaryIterations",
            "supportRelativeThreshold",
            "absorptionMaximumIterations",
            "absorptionTolerance"
          ],
          "properties": {
            "subdivisions": { "$ref": "#/$defs/positiveInteger" },
            "pointsPerBox": { "$ref": "#/$defs/positiveInteger" },
            "epsilon": { "type": "number", "minimum": 0 },
            "integrationTime": { "$ref": "#/$defs/nullableNumber" },
            "stationaryIterations": { "$ref": "#/$defs/positiveInteger" },
            "supportRelativeThreshold": { "type": "number", "exclusiveMinimum": 0 },
            "absorptionMaximumIterations": { "$ref": "#/$defs/positiveInteger" },
            "absorptionTolerance": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "geometricOffsets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contourEpsilon",
            "inverseIterations",
            "inversePositionTolerance",
            "inversePositionToleranceRule",
            "inverseNormalTolerance",
            "inverseMaximumSubdivisionDepth",
            "maximumSeedPoints"
          ],
          "properties": {
            "contourEpsilon": { "type": "number", "exclusiveMinimum": 0 },
            "contourEpsilons": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": { "type": "number", "minimum": 0.001, "maximum": 1 }
            },
            "inverseIterations": { "type": "integer", "minimum": 1, "maximum": 8 },
            "inversePositionTolerance": { "$ref": "#/$defs/nullableNumber" },
            "inversePositionToleranceRule": { "type": "string", "minLength": 1 },
            "inverseNormalTolerance": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
            "inverseMaximumSubdivisionDepth": { "type": "integer", "minimum": 0, "maximum": 10 },
            "maximumSeedPoints": { "type": "integer", "minimum": 3 }
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodic",
        "manifolds",
        "continuousBoundary",
        "geometricOffsets",
        "ulam",
        "parameterSweep"
      ],
      "properties": {
        "periodic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["orbits", "computeMethod", "support"],
          "properties": {
            "orbits": { "type": "array", "items": { "type": "object" } },
            "computeMethod": { "type": ["string", "null"] },
            "support": { "type": ["object", "null"] }
          }
        },
        "manifolds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unstable", "stable", "fixedPoints", "intersections"],
          "properties": {
            "unstable": { "type": "array" },
            "stable": { "type": "array" },
            "fixedPoints": { "type": "array" },
            "intersections": { "type": "array" }
          }
        },
        "continuousBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["points"],
          "properties": { "points": { "type": "array" } }
        },
        "geometricOffsets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direct", "inverse"],
          "properties": {
            "direct": { "type": ["object", "null"] },
            "inverse": { "type": ["object", "null"] }
          }
        },
        "ulam": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gridBoxes", "stationaryDensity", "absorptionProbabilities"],
          "properties": {
            "gridBoxes": { "type": "array" },
            "stationaryDensity": {
              "type": ["array", "null"],
              "items": { "$ref": "#/$defs/finiteNumber" }
            },
            "absorptionProbabilities": {
              "type": ["array", "null"],
              "items": { "$ref": "#/$defs/finiteNumber" }
            }
          }
        },
        "parameterSweep": { "type": ["object", "array", "null"] }
      }
    }
  }
}
